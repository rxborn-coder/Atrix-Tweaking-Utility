@echo off
:: Windows Tweak Menu  –  self-contained batch + PowerShell
:: v1.0  2025-12-07   –  run as administrator
setlocal EnableExtensions EnableDelayedExpansion
set "psFile=%temp%\%~n0.ps1"

(
echo # Embedded PowerShell tweak menu
echo #Requires -RunAsAdministrator
echo $Log = "$env:TEMP\TweakMenu.log"
echo Start-Transcript -Path $Log -Append -Force ^>NUL
echo $choices = @(
echo     [pscustomobject]@{Num=1;  Desc='Disable SysMain (Superfetch)'^;                      UndoDesc='Enable SysMain'},
echo     [pscustomobject]@{Num=2;  Desc='Set High-Performance power plan'^;                   UndoDesc='Set Balanced power plan'},
echo     [pscustomobject]@{Num=3;  Desc='Turn off heavy visual effects'^;                     UndoDesc='Restore default visual effects'},
echo     [pscustomobject]@{Num=4;  Desc='Clean temp files'^;                                UndoDesc=$null},
echo     [pscustomobject]@{Num=5;  Desc='Disable non-Microsoft startup items'^;               UndoDesc='(manual re-enable required)'},
echo     [pscustomobject]@{Num=6;  Desc='Disable OneDrive auto-start (current user)'^;        UndoDesc='Re-enable OneDrive auto-start'},
echo     [pscustomobject]@{Num=7;  Desc='Disable telemetry ^& data collection (basic level)'^; UndoDesc='Restore default telemetry'},
echo     [pscustomobject]@{Num=9;  Desc='UNDO – revert checked tweaks'^;                      UndoDesc=$null},
echo     [pscustomobject]@{Num=0;  Desc='Exit'^;                                              UndoDesc=$null}
echo ^)
echo function Show-Menu {
echo     Clear-Host
echo     Write-Host "`n===== Windows Tweak Menu =====" -ForegroundColor Cyan
echo     $choices ^| Where-Object Num -ne 0 ^| Format-Table Num, Desc -AutoSize
echo     Write-Host " 0. Exit" -ForegroundColor DarkGray
echo }
echo function Invoke-Tweak {
echo     param([int]$num^)
echo     switch ($num^) {
echo         1 { Stop-Service SysMain -Force; Set-Service SysMain -StartupType Disabled; Write-Host "SysMain disabled." -ForegroundColor Green }
echo         2 { $g = (Get-CimInstance -Namespace root\cimv2\power -ClassName Win32_PowerPlan ^| ? ElementName -eq 'High performance').InstanceID.Split('{')[1].Split('}')[0]; powercfg /S $g; Write-Host "High-Performance plan set." -ForegroundColor Green }
echo         3 { Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects' -Name VisualFXSetting -Value 2; Write-Host "Visual effects set to 'Best performance'." -ForegroundColor Green }
echo         4 { Get-ChildItem $env:TEMP -Recurse -Force -ErrorAction SilentlyContinue ^| Remove-Item -Force -Recurse -ErrorAction SilentlyContinue; Write-Host "Temp files cleaned." -ForegroundColor Green }
echo         5 { Get-CimInstance Win32_StartupCommand ^| ? { $_.Location -notmatch 'Microsoft' -and $_.Name -notmatch 'Windows|Security|Defender|Intel|AMD|NVIDIA' } ^| % { $r = $_.Location -replace 'HKLM\\SOFTWARE','HKLM:\SOFTWARE' -replace 'HKCU\\SOFTWARE','HKCU:\SOFTWARE'; Remove-ItemProperty -Path $r -Name $_.Name -ErrorAction SilentlyContinue }; Write-Host "Non-MS startup items disabled." -ForegroundColor Green }
echo         6 { Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name 'OneDrive' -Value $null -ErrorAction SilentlyContinue; Write-Host "OneDrive auto-start disabled." -ForegroundColor Green }
echo         7 { Set-ItemProperty -Path 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection' -Name AllowTelemetry -Value 0 -Force -ErrorAction SilentlyContinue; Write-Host "Telemetry disabled." -ForegroundColor Green }
echo     }
echo }
echo function Invoke-Undo {
echo     param([int[]]$nums^)
echo     foreach ($num in $nums^) {
echo         switch ($num^) {
echo             1 { Set-Service SysMain -StartupType Automatic; Start-Service SysMain -ErrorAction SilentlyContinue }
echo             2 { $b = (Get-CimInstance -Namespace root\cimv2\power -ClassName Win32_PowerPlan ^| ? ElementName -eq 'Balanced').InstanceID.Split('{')[1].Split('}')[0]; powercfg /S $b }
echo             3 { Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects' -Name VisualFXSetting -Value 1 }
echo             6 { $od = "$env:ProgramFiles\Microsoft OneDrive\OneDrive.exe"; if (Test-Path $od^) { Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' -Name 'OneDrive' -Value "`"$od`" /background" } }
echo             7 { Remove-ItemProperty -Path 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection' -Name AllowTelemetry -Force -ErrorAction SilentlyContinue }
echo         }
echo         Write-Host "Undone tweak #$num" -ForegroundColor Yellow
echo     }
echo }
echo while ($true^) {
echo     Show-Menu
echo     $in = Read-Host "`nEnter numbers (comma-separated), 9 to UNDO, 0 to quit"
echo     if ($in -eq '0'^) { break }
echo     if ($in -eq '9'^) { $undone = Read-Host "Tweak numbers to UNDO (comma-separated)"; Invoke-Undo ($undone -split ',' ^| % { [int]$_.Trim() }^); pause; continue }
echo     $picked = $in -split ',' ^| % { [int]$_.Trim() }
echo     foreach ($p in $picked^) { Invoke-Tweak $p }
echo     pause
echo }
echo Stop-Transcript ^>NUL
) > "%psFile%"

:: elevate if not admin
fltmc >nul 2>&1 || (
    echo This script must be run as Administrator.
    powershell -NoP -C "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

:: launch the embedded PowerShell menu
powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%psFile%"
del "%psFile%" 2>nul
endlocal
pause
