@echo off
::          ╔═══════════════════════════════════════════════════════════════════════╗
::          ║              ATRIX MOBILE BUILD TWEAKS - PC EDITION                   ║
::          ║                                                                       ║
::          ║  Turns your keyboard + mouse into a mobile-building machine:          ║
::          ║  • Instant reset macros                                               ║
::          ║  • Ultra-low latency tweaks                                           ║
::          ║  • "Swipe-edit" mouse curve                                           ║
::          ║  • 1-minute quick setup  +  full advanced menu                        ║
::          ║                                                                       ║
::          ║  Run as Admin  |  Q = quit  |  R = reset all                        ║
::          ╚═══════════════════════════════════════════════════════════════════════╝
title ATRIX MOBILE BUILD TWEAKS
setlocal EnableDelayedExpansion
pushd "%~dp0"
fltmc >nul 2>&1 || (
    color 4F & echo    █  Run as Administrator! & pause & exit /b 1
)

:: ----------  COLOUR THEME (BLUE/GREEN/BLACK) ----------
:: 1=blue  2=green  3=cyan  5=purple  0=black  F=white
set "c1=1" & set "c2=2" & set "c3=3" & set "c4=5" & set "c5=0"
:: ------------------------------------------------------

:: ----------  CREATE RESTORE POINT ----------
color 0%c1%
echo.
echo        ╔──────────────── CREATING RESTORE POINT ─────────────────────────────╗
echo        ║                                                                     ║
echo        ║  [Atrix] A restore point is being created automatically…           ║
echo        ║                                                                     ║
echo        ╚─────────────────────────────────────────────────────────────────────╝
powershell -NoProfile -Command "Checkpoint-Computer -Description 'Before Atrix Mobile Build Tweaks' -RestorePointType 'MODIFY_SETTINGS'" 2>nul || (
    echo        ⚠ Could not create restore point – continuing anyway…
)
timeout /t 3 >nul

:: ----------  QUICK 1-MINUTE MOBILE SETUP ----------
:quick
color 0%c2%
cls
echo.
echo        ╔────────────── 1-MINUTE MOBILE-STYLE SETUP ────────────────────────╗
echo        ║                                                                     ║
echo        ║  [1] High-performance power plan                                    ║
echo        ║  [2] 1000 Hz mouse polling (HID)                                    ║
echo        ║  [3] Instant reset macro files (F4 + scroll)                        ║
echo        ║  [4] Low-latency network + timer tweaks                             ║
echo        ║  [5] Mobile-style mouse curve (swipe-edit feel)                     ║
echo        ║                                                                     ║
echo        ╚─────────────────────────────────────────────────────────────────────╗
echo.
choice /c YNQ /n /m "Apply 1-min mobile setup? (Y=Yes N=No Q=Quit):"
set ch=%errorlevel%
if %ch%==3 exit /b 0
if %ch%==2 goto :menu
call :oneMinute
goto :menu

:: ----------  FULL INTERACTIVE MENU ----------
:menu
color 0%c3%
cls
echo.
echo        ╔═══════════════ ATRIX MOBILE BUILD TWEAKS ═════════════════════════╗
echo        ║                                                                     ║
echo        ║  1  Power-plan + CPU tweaks               7  Mouse 1000 Hz + USB   ║
echo        ║  2  Game/DVR off (less hitches)           8  Network low-latency   ║
echo        ║  3  Visual delays off                     9  OS timer (dynamic-tick)
echo        ║  4  Startup bloat kill                     A  INSTANT RESET MACROS  |
echo        ║  5  Services debloat                       B  Swipe-edit mouse curve|
echo        ║  6  Prefetch off (smoother frames)         C  FULL ADVANCED BUILD  |
echo        ║                                                                     ║
echo        ║  X  Apply ALL above (recommended)                                   ║
echo        ║  R  Reset everything to Windows defaults                            ║
echo        ║  Q  Quit                                                            ║
echo        ║                                                                     ║
echo        ╚══════════════════════════════════════════════════════════════════════╝
echo.
choice /c 123456789ABCXQR /n /m "Pick mobile-style tweak:"
set choice=%errorlevel%
if %choice%==1  goto :power
if %choice%==2  goto :gamebar
if %choice%==3  goto :visual
if %choice%==4  goto :startup
if %choice%==5  goto :services
if %choice%==6  goto :memory
if %choice%==7  goto :mouse
if %choice%==8  goto :network
if %choice%==9  goto :timer
if %choice%==10 goto :resetMacros
if %choice%==11 goto :mouseCurve
if %choice%==12 goto :advancedBuild
if %choice%==13 goto :all
if %choice%==14 goto :reset
if %choice%==15 exit /b 0
goto :menu

:: ----------  1-MINUTE ROUTINE  ----------
:oneMinute
echo.
echo [Atrix-1-Min] Applying mobile-speed setup ...
:: 1. High-performance plan
powercfg -duplicatescheme 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul
for /f "tokens=4" %%a in ('powercfg -list ^| findstr /c:"High performance"') do set GUID=%%a
powercfg -setactive %GUID%
:: 2. 1000 Hz mouse
reg add "HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters" /v MouseDataQueueSize /t REG_DWORD /d 64 /f >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Class\{4d36e96b-e325-11ce-bfc1-08002be10318}\0000" /v PollRate /t REG_DWORD /d 1000 /f >nul
:: 3. Instant reset macros
call :resetMacros
:: 4. Low-latency net + timer
netsh int tcp set global autotuninglevel=disabled >nul
netsh int tcp set global rss=enabled >nul
bcdedit /set disabledynamictick yes >nul
bcdedit /set useplatformtick yes >nul
:: 5. Mobile swipe curve
call :mouseCurve
echo Done.
timeout /t 2 >nul
goto :eof

:: ----------  INDIVIDUAL TWEAKS  ----------
:power
color 0%c2%
echo.
echo        ╔────────────── POWER-PLAN + CPU TWEAKS ─────────────────────────────╗
echo        ║  CPU min/max 100 %  •  USB sleep OFF  •  HDD never sleep           ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
powercfg -duplicatescheme 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >nul
for /f "tokens=4" %%a in ('powercfg -list ^| findstr /c:"High performance"') do set GUID=%%a
powercfg -setactive %GUID%
powercfg -setacvalueindex %GUID% SUB_PROCESSOR PROCTHROTTLEMIN 100
powercfg -setacvalueindex %GUID% SUB_PROCESSOR PROCTHROTTLEMAX 100
powercfg -setacvalueindex %GUID% SUB_USB USB3LINKPOWERMANAGEMENT 0
powercfg -setacvalueindex %GUID% SUB_SLEEP STANDBYTimeout 0
powercfg -setacvalueindex %GUID% SUB_DISK DISKIDLE 0
powercfg -setactive %GUID%
echo Done.
pause
goto :menu

:gamebar
color 0%c1%
echo.
echo        ╔────────────── GAME-BAR / DVR / OVERLAY OFF ────────────────────────╗
echo        ║  Removes hitches & capture hooks = smoother swipe builds            ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
reg add "HKCU\SOFTWARE\Microsoft\GameBar" /v AllowAutoGameMode /t REG_DWORD /d 0 /f >nul
reg add "HKCU\System\GameConfigStore" /v GameDVR_Enabled /t REG_DWORD /d 0 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\GameDVR" /v AllowGameDVR /t REG_DWORD /d 0 /f >nul
echo Done.
pause
goto :menu

:visual
color 0%c3%
echo.
echo        ╔────────────── VISUAL DELAYS OFF ────────────────────────────────────╗
echo        ║  Menu fades & hung-app timeouts killed = faster edit flow           ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
reg add "HKCU\Control Panel\Desktop" /v MenuShowDelay /t REG_SZ /d 0 /f >nul
reg add "HKCU\Control Panel\Desktop" /v WaitToKillAppTimeout /t REG_SZ /d 2000 /f >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Control" /v WaitToKillServiceTimeout /t REG_SZ /d 2000 /f >nul
reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" /v VisualFXSetting /t REG_DWORD /d 2 /f >nul
echo Done.
pause
goto :menu

:startup
color 0%c5%
echo.
echo        ╔────────────── STARTUP BLOAT REMOVER ────────────────────────────────╗
echo        ║  OneDrive, Spotify, Discord, Teams, EdgeUpdate stripped             ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
for %%a in (OneDrive,Spotify,Discord,Steam,Skype,Teams,EdgeUpdate,AdobeGCInvoker) do (
  reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run" /v "%%a" /f >nul 2>&1
  reg delete "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run" /v "%%a" /f >nul 2>&1
)
echo Done.
pause
goto :menu

:services
color 0%c6%
echo.
echo        ╔────────────── SERVICES DEBLOAT ──────────────────────────────────────╗
echo        ║  Telemetry, Maps, Fax, Error-reporting disabled = less background   ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
for %%s in (DiagTrack,dmwappushservice,MapsBroker,lfsvc,SharedAccess,TabletInputService,WerSvc,Fax,SysMain) do (
  sc stop %%s >nul 2>&1
  sc config %%s start= disabled
)
echo Done.
pause
goto :menu

:memory
color 0%c1%
echo.
echo        ╔────────────── MEMORY / PREFETCH OFF ────────────────────────────────╗
echo        ║  Superfetch & Prefetch OFF = smoother frame-times for fast builds   ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
sc config SysMain start= disabled >nul 2>&1
sc stop SysMain >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnablePrefetcher /t REG_DWORD /d 0 /f >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnableSuperfetch /t REG_DWORD /d 0 /f >nul
echo Done.
pause
goto :menu

:mouse
color 0%c3%
echo.
echo        ╔────────────── MOUSE 1000 Hz + USB POWER OFF ────────────────────────╗
echo        ║  Bigger HID queue, no suspend, 1 ms polling = swipe-edit ready      ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
for /f "tokens=4" %%a in ('powercfg -list ^| findstr /c:"High performance"') do set GUID=%%a
reg add "HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters" /v MouseDataQueueSize /t REG_DWORD /d 64 /f >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Class\{4d36e96b-e325-11ce-bfc1-08002be10318}\0000" /v PollRate /t REG_DWORD /d 1000 /f >nul
powercfg -setacvalueindex %GUID% 2a737441-1930-4402-8d77-b2bebba308a3 d4e98f31-ffe9-4ce3-bef7-4ca2a23269ba 0
powercfg -setactive %GUID%
echo Done.
pause
goto :menu

:network
color 0%c2%
echo.
echo        ╔────────────── NETWORK LOW-LATENCY ──────────────────────────────────╗
echo        ║  Nagle OFF, ACK every packet, RSS on = snappy edit confirms         ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
netsh int tcp set global autotuninglevel=disabled >nul
netsh int tcp set global chimney=disabled >nul
netsh int tcp set global rss=enabled >nul
netsh int tcp set global netdma=enabled >nul
netsh int tcp set global dca=enabled >nul
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v NetworkThrottlingIndex /t REG_DWORD /d 0xffffffff /f >nul
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v SystemResponsiveness /t REG_DWORD /d 0 /f >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters" /v TcpAckFrequency /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters" /v TCPNoDelay /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters" /v TcpDelAckTicks /t REG_DWORD /d 0 /f >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters" /v DefaultTTL /t REG_DWORD /d 64 /f >nul
echo Done.
pause
goto :menu

:timer
color 0%c5%
echo.
echo        ╔────────────── OS TIMER TWEAKS ──────────────────────────────────────╗
echo        ║  Dynamic-tick OFF + platform-tick ON = lower DPC, faster swaps      ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
bcdedit /set disabledynamictick yes >nul
bcdedit /set useplatformtick yes >nul
echo Done.
pause
goto :menu

:resetMacros
color 0%c4%
echo.
echo        ╔────────────── INSTANT RESET MACROS ─────────────────────────────────╗
echo        ║  Creates F4 (reset) + Scroll (edit) hot-keys for zero-delay edits   ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
:: Save tiny AHK snippet to %userprofile%\mobile_macros.ahk
set "ahk=%userprofile%\mobile_macros.ahk"
(
echo ; Mobile-style instant reset on F4, edit on Scroll
echo F4::
echo   Send {Edit}{Reset}
echo return
echo Scroll::
echo   Send {Edit}
echo return
) > "%ahk%"
echo Macro file created: %ahk%
echo   (Install AutoHotkey and double-click the file.)
echo Done.
pause
goto :menu

:mouseCurve
color 0%c6%
echo.
echo        ╔────────────── SWIPE-EDIT MOUSE CURVE ───────────────────────────────╗
echo        ║  Applies mobile-like acceleration for flick-edits                   ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
:: Windows built-in curve tweak (smooths fast swipes)
reg add "HKCU\Control Panel\Mouse" /v MouseSensitivity /t REG_SZ /d 20 /f >nul
reg add "HKCU\Control Panel\Mouse" /v MouseSpeed /t REG_SZ /d 0 /f >nul
reg add "HKCU\Control Panel\Mouse" /v MouseThreshold1 /t REG_SZ /d 0 /f >nul
reg add "HKCU\Control Panel\Mouse" /v MouseThreshold2 /t REG_SZ /d 0 /f >nul
echo Done.
pause
goto :menu

:advancedBuild
color 0%c4%
echo.
echo        ╔────────────── ADVANCED MOBILE-STYLE ROUTINE ────────────────────────╗
echo        ║  1. 90s drill: hold W + floor-ramp-wall × 20 (no pauses)           ║
echo        ║  2. Swipe-edit: edit floor + reset within 0.15 s (use macro)       ║
echo        ║  3. High-layer tunnel: floor-cone-ramp-wall × 10 (scroll wheel)    ║
echo        ║  4. Motion flick: 180° turn + instant floor + ramp (mouse flick)   ║
echo        ║  5. Speed-retake: jump + floor-ramp-edit × 5 (mobile rhythm)       ║
echo        ║                                                                     ║
echo        ║  Practice each drill 3 × daily until muscle memory = mobile speed  ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
echo.
echo Press any key when you finish the routine …
pause >nul
goto :menu

:all
call :oneMinute
call :resetMacros
call :mouseCurve
goto :done

:reset
color 0%c4%
echo.
echo        ╔────────────── RESET TO WINDOWS DEFAULTS ────────────────────────────╗
echo        ║  Reverting all tweaks …                                             ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
powercfg -setactive 381b4222-f694-41f0-9685-ff5bb260df2e >nul
for %%s in (DiagTrack,dmwappushservice,MapsBroker,lfsvc,SharedAccess,TabletInputService,WerSvc,Fax,SysMain) do sc config %%s start= demand >nul
netsh int tcp set global autotuninglevel=normal >nul
bcdedit /set disabledynamictick no >nul
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnablePrefetcher /t REG_DWORD /d 3 /f >nul
echo Reset complete.
pause
goto :menu

:done
color 0%c6%
echo.
echo        ╔──────────────── ATRIX MOBILE BUILD TWEAKS COMPLETE ─────────────────╗
echo        ║                                                                     ║
echo        ║  ✔ All mobile-speed tweaks applied.                                 ║
echo        ║  ✔ Reboot NOW for full effect (macros + timer).                     ║
echo        ║                                                                     ║
echo        ║  Daily routine: 90s → swipe-edit → tunnel → flick → retake          ║
echo        ║  Repeat each 3× daily = mobile muscle memory on PC!                 ║
echo        ║                                                                     ║
echo        ╚──────────────────────────────────────────────────────────────────────╝
echo.
echo        [Atrix] Tweaks are done - rebooting in 15 seconds...
pause >nul
shutdown /r /t 15 /c "Atrix Mobile Build Tweaks applied – rebooting in 15 s…"
exit /b 0
