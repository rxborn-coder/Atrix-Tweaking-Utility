@echo off
::  Rxborn Core Optimizer  –  Win 7 → 11  (safe, reversible, CMD-only)
::  v5.0  2025-12-07  –  Optional virus scan
setlocal EnableExtensions EnableDelayedExpansion
title Rxborn Core Optimizer  (ADMIN)

fltmc >nul 2>&1 || (
  mshta vbscript:Execute("CreateObject(""Shell.Application"").ShellExecute ""cmd.exe"",""/c """"%~f0"""" "",, ""runas"",1")(window.close)
  exit /b
)

:: =====  MAIN MENU  =====
:menu
cls
echo ======================  Rxborn Core Optimizer  ======================
echo.
echo  1  SysMain / Prefetch tweaks
echo  2  Power-plan & CPU tweaks
echo  3  Visual & shell effects
echo  4  Temp & cache cleanup
echo  5  Startup & services
echo  6  OneDrive / cloud tweaks
echo  7  Telemetry & background tasks
echo  8  Network & SMB tweaks
echo  9  NTFS & file-system tweaks
echo  10 Input tweaks (KBM ^& Controller)
echo.
echo  V  Virus scan (Defender + MBAM)
echo  R  REVERT (undo selected)
echo  0  Exit
echo.
choice /c 12345678910vr0 /n /m "Choose: "
set "ch=%errorlevel%"
if /i "%ch%"=="0"  exit /b
if /i "%ch%"=="21" goto virusScan
if /i "%ch%"=="22" goto revert
call :cat%ch%
pause
goto menu

::::::::::::  OPTIONAL VIRUS SCAN  ::::::::::::::
:virusScan
cls
echo [Rxborn] Starting virus scan ...
:: 1. Quick Defender scan
echo  [Scan] Microsoft Defender Quick Scan ...
mpcmdrun -Scan -ScanType 1 >nul 2>&1
if %errorlevel% neq 0 (
  echo  [Scan] Defender found threats – auto-removing ...
  mpcmdrun -Remove -All >nul 2>&1
)

:: 2. Malwarebytes free CLI (if present)
where mbam.exe >nul 2>&1 && (
  echo  [Scan] Malwarebytes quick scan ...
  mbam /quick /silent /noreboot
  if %errorlevel% neq 0 (
    echo  [Scan] MBAM found threats – check quarantine.
  )
) || (
  echo  [Scan] MBAM CLI not found – skipping.
)

:: 3. Simple miner check
wmic process where "name like '%%miner%%' or name like '%%xmrig%%' or name like '%%nicehash%%'" get name 2>nul | findstr /i "miner xmrig nicehash" >nul && (
  echo  [Scan] KNOWN MINER DETECTED – terminating ...
  wmic process where "name like '%%miner%%' or name like '%%xmrig%%' or name like '%%nicehash%%'" call terminate >nul 2>&1
)

echo [Rxborn] Scan complete – returning to menu.
pause
goto menu

::::::::::::  CREATE RESTORE POINT (only after user picks first tweak)  ::::::::::::::
:makeRP
echo [Rxborn] Creating restore point ...
wmic.exe /Namespace:\\root\default Path SystemRestore Call CreateRestorePoint "Rxborn-CoreOptimize-%DATE%", 100, 7 >nul 2>&1
if %errorlevel%==0 (
  echo [Rxborn] Restore point created – FINISHED
) else (
  echo [Rxborn] WARNING: could not create restore point – continuing anyway
)
set "rpDone=1"
goto :eof

::::::::::::  CAT 1 – SysMain  ::::::::::::::
:cat1
if not defined rpDone call :makeRP
cls
echo ===== 1. SysMain / Prefetch =====
echo  1  Disable SysMain + Prefetch=Apps
echo  2  Clear Prefetch folder
echo  0  Back
choice /c 120 /n /m "Pick: "
if %errorlevel%==1 goto :eof
if %errorlevel%==2 call :t1-1&call :t1-2
goto :eof

:t1-1
sc query SysMain | find "RUNNING" >nul && sc stop SysMain
sc config SysMain start= disabled
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnablePrefetcher /t REG_DWORD /d 2 /f >nul
echo [Rxborn] SysMain disabled + Prefetch=Apps – FINISHED
goto :eof

:t1-2
del /s /f /q "%SystemRoot%\Prefetch\*.*" >nul 2>&1
echo [Rxborn] Prefetch cache cleared – FINISHED
goto :eof

::::::::::::  CAT 2 – Power  ::::::::::::::
:cat2
if not defined rpDone call :makeRP
cls
echo ===== 2. Power/CPU =====
echo  1  High-Performance plan
echo  2  Disable hibernation
echo  3  USB selective suspend OFF
echo  0  Back
choice /c 1230 /n /m "Pick: "
if %errorlevel%==1 goto :eof
if %errorlevel%==2 call :t2-1
if %errorlevel%==3 call :t2-2
if %errorlevel%==4 call :t2-3
goto :eof

:t2-1
powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c
echo [Rxborn] High-Performance plan – FINISHED
goto :eof

:t2-2
powercfg /hibernate off
echo [Rxborn] Hibernation disabled – FINISHED
goto :eof

:t2-3
powercfg /SETACVALUEINDEX SCHEME_CURRENT 2a737441-1930-4402-8d77-b2bebba308a3 48e6b7a6-50f5-4782-a5d4-53bb8f07e226 0
powercfg /SETDCVALUEINDEX SCHEME_CURRENT 2a737441-1930-4402-8d77-b2bebba308a3 48e6b7a6-50f5-4782-a5d4-53bb8f07e226 0
powercfg /setactive scheme_current
echo [Rxborn] USB selective suspend OFF – FINISHED
goto :eof

::::::::::::  CAT 3 – Visual  ::::::::::::::
