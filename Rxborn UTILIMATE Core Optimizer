::::::::::::  CAT 4 – Temp  ::::::::::::::
:cat4
if not defined rpDone call :makeRP
cls
echo ===== 4. Temp & Cache =====
echo  1  Clean user %TEMP%
echo  2  Windows Update cache
echo  3  Empty Recycle-Bin all drives
echo  0  Back
choice /c 1230 /n /m "Pick: "
if %errorlevel%==1 goto :eof
if %errorlevel%==2 call :t4-1
if %errorlevel%==3 call :t4-2
if %errorlevel%==4 call :t4-3
goto :eof

:t4-1
del /s /f /q "%TEMP%\*" >nul 2>&1
for /d %%D in ("%TEMP%\*") do rd /s /q "%%D" 2>nul
md "%TEMP%" 2>nul
echo [Rxborn] User temp cleaned – FINISHED
goto :eof

:t4-2
net stop wuauserv >nul 2>&1
del /s /f /q "%windir%\SoftwareDistribution\Download\*.*" >nul 2>&1
net start wuauserv >nul 2>&1
echo [Rxborn] Windows Update cache cleared – FINISHED
goto :eof

:t4-3
for /f "skip=1" %%D in ('wmic logicaldisk get caption') do rd /s /q "%%D\$Recycle.Bin" 2>nul
echo [Rxborn] Recycle-Bin emptied – FINISHED
goto :eof

::::::::::::  CAT 5 – Services  ::::::::::::::
:cat5
if not defined rpDone call :makeRP
cls
echo ===== 5. Startup & Services =====
echo  1  List 3rd-party startup
echo  2  Disable Windows Search
echo  3  Disable Print Spooler
echo  0  Back
choice /c 1230 /n /m "Pick: "
if %errorlevel%==1 goto :eof
if %errorlevel%==2 call :t5-1
if %errorlevel%==3 call :t5-2
if %errorlevel%==4 call :t5-3
goto :eof

:t5-1
wmic startup get caption,command /value 2>nul | findstr /i /v "Microsoft=Windows=Defender=Intel=AMD=NVIDIA=" | more
echo [Rxborn] Listed 3rd-party startup – FINISHED
goto :eof

:t5-2
sc query WSearch | find "RUNNING" >nul && sc stop WSearch
sc config WSearch start= disabled
echo [Rxborn] Windows Search disabled – FINISHED
goto :eof

:t5-3
sc query Spooler | find "RUNNING" >nul && sc stop Spooler
sc config Spooler start= disabled
echo [Rxborn] Print Spooler disabled – FINISHED
goto :eof

::::::::::::  CAT 6 – OneDrive  ::::::::::::::
