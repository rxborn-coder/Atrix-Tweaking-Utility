reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RawInput" /v EnableRawInput /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\RawInput" /v EnableRawInput /t REG_DWORD /d 1 /f >nul 2>&1
