choice /c 123456780 /n /m "Undo: "
set "un=%errorlevel%"
if %un%==9 goto menu
if %un%==1 call :r1
if %un%==2 call :r2
if %un%==3 call :r3
if %un%==4 call :r4
if %un%==5 call :r5
if %un%==6 call :r6
if %un%==7 call :r7
