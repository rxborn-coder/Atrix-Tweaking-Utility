call :makeRP
cls
echo ===== 2. Power/CPU =====
echo  1  High-Performance plan
echo  2  Disable hibernation
echo  3  USB selective suspend OFF
echo  0  Back
choice /c 1230 /n /m "Pick: "
if %errorlevel%==1 goto :eof
if %errorlevel%==2 call :t2-1
if %errorlevel%==3 call :t2-2
if %errorlevel%==4 call :t2-3
goto :eof

:t2-1
echo [2] Setting High-Performance ...
powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c >> "%log%" 2>&1
echo [2] High-Performance plan – FINISHED
pause >nul
goto :eof

:t2-2
echo [2] Disabling hibernation ...
powercfg /hibernate off >> "%log%" 2>&1
echo [2] Hibernation disabled – FINISHED
pause >nul
goto :eof

:t2-3
echo [2] USB selective suspend OFF ...
powercfg /SETACVALUEINDEX SCHEME_CURRENT 2a737441-1930-4402-8d77-b2bebba308a3 48e6b7a6-50f5-4782-a5d4-53bb8f07e226 0 >> "%log%" 2>&1
powercfg /SETDCVALUEINDEX SCHEME_CURRENT 2a737441-1930-4402-8d77-b2bebba308a3 48e6b7a6-50f5-4782-a5d4-53bb8f07e226 0 >> "%log%" 2>&1
powercfg /setactive scheme_current >> "%log%" 2>&1
echo [2] USB selective suspend OFF – FINISHED
pause >nul
goto :eof

