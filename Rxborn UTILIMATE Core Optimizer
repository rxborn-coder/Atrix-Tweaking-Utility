::::::::::::  CATEGORY 4 – Temp  ::::::::::::::
:cat4
call :makeRP
cls
echo ===== 4. Temp & Cache =====
echo  1  Clean user %TEMP%
echo  2  Windows Update cache
echo  3  Empty Recycle-Bin all drives
echo  0  Back
choice /c 1230 /n /m "Pick: "
if %errorlevel%==1 goto :eof
if %errorlevel%==2 call :t4-1
if %errorlevel%==3 call :t4-2
if %errorlevel%==4 call :t4-3
goto :eof

:t4-1
echo [4] Cleaning %%TEMP%% ...
del /s /f /q "%TEMP%\*" >> "%log%" 2>&1
for /d %%D in ("%TEMP%\*") do rd /s /q "%%D" >> "%log%" 2>&1
echo [4] User temp cleaned – FINISHED
pause >nul
goto :eof

:t4-2
echo [4] Windows Update cache ...
net stop wuauserv >> "%log%" 2>&1
del /s /f /q "%windir%\SoftwareDistribution\Download\*.*" >> "%log%" 2>&1
net start wuauserv >> "%log%" 2>&1
echo [4] Update cache cleared – FINISHED
pause >nul
goto :eof

:t4-3
echo [4] Emptying Recycle-Bin ...
for /f "skip=1" %%D in ('wmic logicaldisk get caption') do rd /s /q "%%D\$Recycle.Bin" >> "%log%" 2>&1
echo [4] Recycle-Bin emptied – FINISHED
pause >nul
goto :eof

