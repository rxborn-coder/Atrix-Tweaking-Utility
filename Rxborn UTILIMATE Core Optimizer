@echo off
::  Rxborn Core Optimizer v7.0  –  Win 7 → 11  (crash-proof, logged, reversible)
setlocal EnableExtensions EnableDelayedExpansion
title Rxborn Core Optimizer v7

:: ----------  admin check  ----------
fltmc >nul 2>&1 || (
    echo [Rxborn] Requesting admin ...
    mshta vbscript:Execute("CreateObject(""Shell.Application"").ShellExecute ""cmd.exe"",""/k """"%~f0"""" "",, ""runas"",1")(window.close)
    exit /b
)

:: ----------  log file  ----------
set "log=%TEMP%\Rxborn-v7.log"
echo [Rxborn] Session started %date% %time% > "%log%"

:: ----------  main menu  ----------
:menu
cls
echo ======================  Rxborn Core Optimizer v7  ======================
echo.
echo  1  SysMain / Prefetch tweaks
echo  2  Power-plan & CPU tweaks
echo  3  Visual & shell effects
echo  4  Temp & cache cleanup
echo  5  Startup & services
echo  6  OneDrive / cloud tweaks
echo  7  Telemetry & background tasks
echo  8  Network & SMB tweaks
echo  9  NTFS & file-system tweaks
echo  10 Input tweaks (KBM ^& Controller)
echo.
echo  V  Virus scan (Defender + MBAM)
echo  R  REVERT (undo selected)
echo  0  Exit
echo.
choice /c 12345678910vr0 /n /m "Choose: "
set "ch=%errorlevel%"
if /i "%ch%"=="0"  exit /b
if /i "%ch%"=="21" call :virusScan  & goto menu
if /i "%ch%"=="22" call :revertMenu & goto menu
call :cat%ch% & goto menu

::::::::::::  OPTIONAL VIRUS SCAN  ::::::::::::::
:virusScan
echo. >> "%log%"
echo [VIRUS] Scan started %date% %time% >> "%log%"
echo [VIRUS] Starting Defender quick scan ...
MpCmdRun -Scan -ScanType 1 >> "%log%" 2>&1
if %errorlevel% neq 0 (
    echo [VIRUS] Defender found threats – auto-removing ...
    MpCmdRun -Remove -All >> "%log%" 2>&1
)
where mbam.exe >nul 2>&1 && (
    echo [VIRUS] Malwarebytes quick scan ...
    mbam /quick /silent /noreboot >> "%log%" 2>&1
)
wmic process where "name like '%%miner%%' or name like '%%xmrig%%' or name like '%%nicehash%%'" get name 2>nul | findstr /i "miner xmrig nicehash" >nul && (
    echo [VIRUS] KNOWN MINER DETECTED – terminating ...
    wmic process where "name like '%%miner%%' or name like '%%xmrig%%' or name like '%%nicehash%%'" call terminate >> "%log%" 2>&1
)
echo [VIRUS] Scan finished – press key
pause >nul
goto :eof

::::::::::::  RESTORE POINT (once only)  ::::::::::::::
:makeRP
if defined rpDone goto :eof
set "rpDone=1"
echo [RP] Creating restore point ...
wmic.exe /Namespace:\\root\default Path SystemRestore Call CreateRestorePoint "Rxborn-v7-%DATE%", 100, 7 >> "%log%" 2>&1
if %errorlevel% equ 0 (
    echo [RP] Restore point created – FINISHED
) else (
    echo [RP] Could not create RP – continuing
)
pause >nul
goto :eof

::::::::::::  CATEGORY 1 – SysMain  ::::::::::::::
:cat1
call :makeRP
cls
echo ===== 1. SysMain / Prefetch =====
echo  1  Disable SysMain + Prefetch=Apps
echo  2  Clear Prefetch folder
echo  0  Back
choice /c 120 /n /m "Pick: "
if %errorlevel%==1 goto :eof
if %errorlevel%==2 call :t1-1&call :t1-2
goto :eof

:t1-1
echo [1] Disabling SysMain ...
sc query SysMain | find "RUNNING" >nul && sc stop SysMain
sc config SysMain start= disabled >> "%log%" 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v EnablePrefetcher /t REG_DWORD /d 2 /f >> "%log%" 2>&1
echo [1] SysMain disabled – FINISHED
pause >nul
goto :eof

:t1-2
echo [1] Clearing Prefetch ...
del /s /f /q "%SystemRoot%\Prefetch\*.*" >> "%log%" 2>&1
echo [1] Prefetch cleared – FINISHED
pause >nul
goto :eof

::::::::::::  CATEGORY 2 – Power  ::::::::::::::
